JWT_SECRET_KEY=VERYVERYSECRETKEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- CORS ---
# Optional: only set this if you need MORE than just FRONTEND_URL allowed
# (e.g. a local dev URL plus the deployed Streamlit URL at the same time).
# Comma-separated, no trailing slashes. If unset, defaults to FRONTEND_URL.
# API_CORS_ORIGINS=https://your-app.streamlit.app,http://localhost:8501

# --- MongoDB (one cluster, one DB - user profile + watchlist live in the
