# --- RAG ---
RAG_DENSE_BACKEND=none

# --- Checkpointer ---
# memory = fine for local dev / Render's free tier (no persistent disk);
# does NOT persist across a Render restart. Use sqlite/postgres + a
# persistent disk if you need the "list your stocks" hand-off to survive
# a redeploy.
CHECKPOINTER_BACKEND=memory
